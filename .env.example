# PostgreSQL
# Dev: Postgres local em Docker (npm run db:local:up). O predev bloqueia qualquer host remoto.
# Produção: qualquer PostgreSQL 15+. Em provedores com pooler (Neon, por exemplo):
#   DATABASE_URL = string com pooler, usada pelo app
#   DIRECT_URL   = string direta, sem pooler: migrations e pg_dump
# Sem pooler, as duas são iguais.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/financaspro?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5434/financaspro?schema=public"

# Login (Better Auth)
# BETTER_AUTH_SECRET: obrigatório em produção, mín. 32 caracteres. Gerar: openssl rand -base64 48
#   (SESSION_SECRET, da versão anterior, continua aceito no lugar dele)
# BETTER_AUTH_URL: endereço público do app, sem barra no fim (ex.: https://financas.seudominio.com)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Usuário inicial pelo seed (opcional; sem isso, crie o primeiro em /setup)
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""

# Fuso usado para "hoje" e "mês atual" (opcional, padrão America/Sao_Paulo)
# APP_TIMEZONE="America/Sao_Paulo"

# Link "Código-fonte" do menu (opcional). Se você publica uma versão MODIFICADA para outras
# pessoas, a AGPL-3.0 pede que ele aponte para o código dessa versão.
# NEXT_PUBLIC_SOURCE_URL="https://github.com/rotalabsco/financaspro"
