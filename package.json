{
  "name": "financas-pro",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "predev": "node scripts/guard-dev-database.mjs",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:local:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:local:down": "docker compose -f docker-compose.dev.yml down",
    "db:local:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d --wait",
    "db:deploy": "drizzle-kit migrate",
    "test": "vitest run",
    "db:setup": "node scripts/setup-db.mjs",
    "db:baseline": "node scripts/db-baseline.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.11",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^12.37.0",
    "geist": "^1.7.0",
    "lucide-react": "^0.460.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.13.3",
    "sonner": "^2.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
